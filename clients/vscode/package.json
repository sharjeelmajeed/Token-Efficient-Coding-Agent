{
  "name": "token-efficient-coding-agent",
  "displayName": "Token-Efficient Coding Agent",
  "description": "A thin, approval-aware client for the Token-Efficient Coding Agent core.",
  "version": "0.3.0", "publisher": "token-agent-hackathon", "license": "UNLICENSED", "private": true,
  "engines": { "vscode": "^1.144.0", "node": ">=22" },
  "categories": ["Other"], "extensionKind": ["workspace"], "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Repository tasks require a trusted workspace and an explicitly configured core connection." },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "commands": [
      { "command": "tokenAgent.configure", "title": "Token Agent: Configure Connection" },
      { "command": "tokenAgent.start", "title": "Token Agent: Start Session" },
      { "command": "tokenAgent.chat", "title": "Token Agent: Open Chat" },
      { "command": "tokenAgent.resume", "title": "Token Agent: Reconnect Session" },
      { "command": "tokenAgent.cancel", "title": "Token Agent: Cancel Run" },
      { "command": "tokenAgent.report", "title": "Token Agent: Open Run Report" }
    ],
    "configuration": { "title": "Token Agent", "properties": {
      "tokenAgent.coreUrl": { "type": "string", "default": "http://127.0.0.1:8765", "scope": "application",
        "description": "Trusted core origin. Repository settings are ignored. Configure through Token Agent: Configure Connection." }
    } }
  },
  "scripts": {
    "compile": "tsc -p .", "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:host": "npm run compile && node test/run-host.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --out token-efficient-coding-agent-0.3.0.vsix"
  },
  "devDependencies": { "@types/node": "^22.0.0", "@types/vscode": "1.144.0",
    "@vscode/test-electron": "3.1.0", "@vscode/vsce": "4.1.0", "typescript": "7.0.2" },
  "overrides": { "@vscode/vsce": { "minimatch": "11.0.1" } }
}
